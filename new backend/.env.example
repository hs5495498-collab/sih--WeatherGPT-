APP_NAME=My Weather API
APP_VERSION=2.0.0
DEBUG=False

WEATHER_API_BASE_URL=

SUPABASE_URL=
SUPABASE_KEY=

RAG_ENABLED=false

NLU_ENABLED=true
NLU_MODEL_PATH=

RATE_LIMIT=30/minute

ALERT_POLL_INTERVAL_SECONDS=

# Comma-separated list of allowed frontend origins (NOT a JSON/array literal --
# app/core/config.py splits this on "," into a list). e.g.:
# ALLOWED_ORIGINS=http://localhost:3000,https://weathergpt-demo.vercel.app
# Set to "*" to allow any origin (only safe because that automatically
# disables credentialed requests -- see app/main.py).
ALLOWED_ORIGINS=
